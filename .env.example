# Copiá este archivo a ".env" (mismo directorio) y completá los valores
# reales. El .env NUNCA se sube a git (ya está en .gitignore) — cada máquina
# donde corra la app (esta PC, la PC-servidor, etc.) tiene su propio .env con
# sus propias credenciales.

# ── Odoo (POS en producción) ──
ODOO_URL=https://tuempresa.odoo.com/
ODOO_DB=nombre-de-tu-base-odoo
ODOO_USER=usuario@tuempresa.com
ODOO_PASSWORD=tu-password-o-api-key-de-odoo
ODOO_COMPANY_ID=2

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_DB=sociaboss
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_PORT=5433

# ── Email (opcional) — solo hace falta para "Olvidé mi contraseña".
# Sin esto configurado, la app sigue funcionando igual, simplemente no puede
# mandar el correo (el link queda anotado en el log del servidor).
# Ejemplo con Gmail: generá una "contraseña de aplicación" en tu cuenta de
# Google (no la contraseña normal) y usala en SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicación
SMTP_FROM=tu-correo@gmail.com

# ── Chat de consultas con IA (opcional) — solo hace falta para el módulo de
# Chat (preguntas como "qué tienda vendió más este mes"). Sin esto configurado
# la app sigue funcionando igual — la pantalla de Chat solo avisa que falta
# configurar la clave. Conseguila en console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui
