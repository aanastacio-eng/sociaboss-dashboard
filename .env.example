# Copiá este archivo a ".env" (mismo directorio) y completá los valores
# reales. El .env NUNCA se sube a git (ya está en .gitignore) — cada máquina
# donde corra la app (esta PC, la PC-servidor, etc.) tiene su propio .env con
# sus propias credenciales.

# ── Odoo (POS en producción) ──
ODOO_URL=https://tuempresa.odoo.com/
ODOO_DB=nombre-de-tu-base-odoo
ODOO_USER=usuario@tuempresa.com
ODOO_PASSWORD=tu-password-o-api-key-de-odoo
ODOO_COMPANY_ID=2

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_DB=sociaboss
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_PORT=5433
